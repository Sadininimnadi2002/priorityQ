# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=5000
NODE_ENV=development

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/priorityq
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/priorityq?retryWrites=true&w=majority

JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# React dev server (Vite default)
CLIENT_URL=http://localhost:5173

# Fairness settings (see utils/priorityEngine.js)
# A waiting person is promoted one priority level for every N minutes waited (0 = off)
AGING_MINUTES=20
# After N consecutive high-priority calls, serve one NORMAL person (0 = off)
MAX_HIGH_STREAK=3
